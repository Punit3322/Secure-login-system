<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SecureAuth Enterprise - Zero-Trust Identity & Access Management</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        secure: {
                            dark: '#030712',
                            card: '#0f172a',
                            border: '#1e293b',
                            accent: '#10b981',
                            glow: 'rgba(16, 185, 129, 0.15)',
                            neon: '#34d399',
                        }
                    },
                    fontFamily: {
                        mono: ['JetBrains Mono', 'Fira Code', 'monospace'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #030712; }
        ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #10b981; }
        .glass-panel {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(30, 41, 59, 0.8);
        }
        .auth-glow {
            box-shadow: 0 0 40px rgba(16, 185, 129, 0.1);
        }
    </style>
</head>
<body class="bg-secure-dark text-slate-100 min-h-screen flex flex-col selection:bg-emerald-500 selection:text-black">

    <!-- Top Security Status Bar -->
    <header class="border-b border-secure-border bg-secure-card/80 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center shadow-lg shadow-emerald-500/20">
                    <i class="fa-solid fa-shield-keyhole text-black text-lg font-bold"></i>
                </div>
                <div>
                    <h1 class="font-bold text-base tracking-wide text-emerald-400 font-mono flex items-center gap-2">
                        SECUREAUTH <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800">ENTERPRISE v4.2</span>
                    </h1>
                    <p class="text-xs text-slate-400">Zero-Trust Identity & Access Management</p>
                </div>
            </div>

            <!-- Security Compliance Badges -->
            <div class="flex items-center space-x-3">
                <div class="hidden sm:flex items-center space-x-2 px-3 py-1.5 rounded-full bg-emerald-950/60 border border-emerald-800/60 text-emerald-400 text-xs font-mono">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>TLS 1.3 • AES-256 ENCRYPTED</span>
                </div>
                <button onclick="switchView('register')" id="top-switch-btn" class="px-4 py-2 bg-secure-dark hover:bg-secure-border border border-secure-border rounded-xl text-xs font-mono text-emerald-400 transition">
                    Create Account
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
        <div class="w-full max-w-md">

            <!-- ==================== VIEW 1: LOGIN FORM ==================== -->
            <div id="view-login" class="glass-panel rounded-2xl p-8 auth-glow space-y-6 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

                <div>
                    <span class="text-xs uppercase font-mono tracking-widest text-emerald-400 font-semibold">Authentication Gateway</span>
                    <h2 class="text-2xl font-bold mt-1">Sign in to your account</h2>
                    <p class="text-slate-400 text-xs mt-1">Enter your credentials to access the secure enterprise dashboard.</p>
                </div>

                <form onsubmit="handleLogin(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-mono text-slate-400 uppercase mb-1.5">Enterprise Email / Username</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                                <i class="fa-solid fa-envelope text-xs"></i>
                            </span>
                            <input type="email" id="login-email" required
                                placeholder="analyst@securecorp.internal"
                                class="w-full pl-10 pr-4 py-3 bg-secure-dark/90 border border-secure-border rounded-xl text-sm font-mono focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition">
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="text-xs font-mono text-slate-400 uppercase">Secure Password</label>
                            <a href="#" onclick="alert('Password reset link has been dispatched to your registered enterprise device.')" class="text-xs text-emerald-400 hover:underline font-mono">Forgot?</a>
                        </div>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                                <i class="fa-solid fa-lock text-xs"></i>
                            </span>
                            <input type="password" id="login-password" required
                                placeholder="••••••••••••"
                                class="w-full pl-10 pr-10 py-3 bg-secure-dark/90 border border-secure-border rounded-xl text-sm font-mono focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition">
                            <button type="button" onclick="togglePasswordVisibility('login-password')" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-500 hover:text-slate-300">
                                <i class="fa-solid fa-eye text-xs" id="login-password-icon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="flex items-center justify-between text-xs pt-1">
                        <label class="flex items-center space-x-2 cursor-pointer text-slate-300">
                            <input type="checkbox" class="w-4 h-4 text-emerald-500 rounded bg-secure-dark border-secure-border focus:ring-emerald-500">
                            <span>Remember this trusted device</span>
                        </label>
                    </div>

                    <button type="submit" id="login-btn"
                        class="w-full py-3.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-black font-bold rounded-xl shadow-lg shadow-emerald-500/20 flex items-center justify-center space-x-2 transition font-mono text-sm">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        <span>AUTHENTICATE</span>
                    </button>
                </form>

                <div class="text-center pt-2 border-t border-secure-border text-xs text-slate-400">
                    Don't have an enterprise identity? 
                    <button onclick="switchView('register')" class="text-emerald-400 font-bold hover:underline font-mono">Register now</button>
                </div>
            </div>


            <!-- ==================== VIEW 2: MFA CHALLENGE ==================== -->
            <div id="view-mfa" class="glass-panel rounded-2xl p-8 auth-glow space-y-6 hidden relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

                <div class="text-center">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-950 text-emerald-400 border border-emerald-800 flex items-center justify-center text-xl mx-auto mb-3 shadow-lg">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <span class="text-xs uppercase font-mono tracking-widest text-emerald-400 font-semibold">Multi-Factor Authentication</span>
                    <h2 class="text-xl font-bold mt-1">Two-Step Verification</h2>
                    <p class="text-slate-400 text-xs mt-1">Enter the 6-digit TOTP code generated by your authenticator app or hardware token.</p>
                </div>

                <form onsubmit="handleMfaVerify(event)" class="space-y-4">
                    <div class="flex justify-center gap-2">
                        <input type="text" maxlength="1" class="w-12 h-14 text-center bg-secure-dark border border-secure-border rounded-xl text-lg font-mono text-emerald-400 focus:outline-none focus:border-emerald-500" required>
                        <input type="text" maxlength="1" class="w-12 h-14 text-center bg-secure-dark border border-secure-border rounded-xl text-lg font-mono text-emerald-400 focus:outline-none focus:border-emerald-500" required>
                        <input type="text" maxlength="1" class="w-12 h-14 text-center bg-secure-dark border border-secure-border rounded-xl text-lg font-mono text-emerald-400 focus:outline-none focus:border-emerald-500" required>
                        <input type="text" maxlength="1" class="w-12 h-14 text-center bg-secure-dark border border-secure-border rounded-xl text-lg font-mono text-emerald-400 focus:outline-none focus:border-emerald-500" required>
                        <input type="text" maxlength="1" class="w-12 h-14 text-center bg-secure-dark border border-secure-border rounded-xl text-lg font-mono text-emerald-400 focus:outline-none focus:border-emerald-500" required>
                        <input type="text" maxlength="1" class="w-12 h-14 text-center bg-secure-dark border border-secure-border rounded-xl text-lg font-mono text-emerald-400 focus:outline-none focus:border-emerald-500" required>
                    </div>

                    <button type="submit" id="mfa-btn"
                        class="w-full py-3.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-black font-bold rounded-xl shadow-lg shadow-emerald-500/20 flex items-center justify-center space-x-2 transition font-mono text-sm">
                        <i class="fa-solid fa-check"></i>
                        <span>VERIFY & PROCEED</span>
                    </button>
                </form>

                <div class="text-center pt-2 border-t border-secure-border text-xs text-slate-400">
                    Lost device access? <button onclick="alert('Contact the IT Security Operations Center (SecOps) at ext. 4911.')" class="text-emerald-400 hover:underline font-mono">Emergency Recovery</button>
                </div>
            </div>


            <!-- ==================== VIEW 3: REGISTRATION FORM ==================== -->
            <div id="view-register" class="glass-panel rounded-2xl p-8 auth-glow space-y-6 hidden relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

                <div>
                    <span class="text-xs uppercase font-mono tracking-widest text-emerald-400 font-semibold">Identity Enrollment</span>
                    <h2 class="text-2xl font-bold mt-1">Create Enterprise Account</h2>
                    <p class="text-slate-400 text-xs mt-1">Register with your corporate email to generate cryptographic keys.</p>
                </div>

                <form onsubmit="handleRegister(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-mono text-slate-400 uppercase mb-1.5">Full Name</label>
                        <input type="text" required placeholder="Alex Mercer"
                            class="w-full px-4 py-3 bg-secure-dark/90 border border-secure-border rounded-xl text-sm font-mono focus:outline-none focus:border-emerald-500 transition">
                    </div>

                    <div>
                        <label class="block text-xs font-mono text-slate-400 uppercase mb-1.5">Corporate Email</label>
                        <input type="email" required placeholder="alex.mercer@securecorp.internal"
                            class="w-full px-4 py-3 bg-secure-dark/90 border border-secure-border rounded-xl text-sm font-mono focus:outline-none focus:border-emerald-500 transition">
                    </div>

                    <div>
                        <label class="block text-xs font-mono text-slate-400 uppercase mb-1.5">Create Secure Password</label>
                        <input type="password" id="reg-password" oninput="checkPasswordStrength(this.value)" required placeholder="••••••••••••"
                            class="w-full px-4 py-3 bg-secure-dark/90 border border-secure-border rounded-xl text-sm font-mono focus:outline-none focus:border-emerald-500 transition">
                        
                        <!-- Password Strength Meter -->
                        <div class="mt-2 space-y-1">
                            <div class="flex gap-1 h-1.5 w-full bg-secure-dark rounded-full overflow-hidden">
                                <div id="str-1" class="w-1/4 bg-secure-border transition-all"></div>
                                <div id="str-2" class="w-1/4 bg-secure-border transition-all"></div>
                                <div id="str-3" class="w-1/4 bg-secure-border transition-all"></div>
                                <div id="str-4" class="w-1/4 bg-secure-border transition-all"></div>
                            </div>
                            <span id="password-strength-text" class="text-[10px] text-slate-400 font-mono">Password strength: Weak</span>
                        </div>
                    </div>

                    <button type="submit"
                        class="w-full py-3.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-black font-bold rounded-xl shadow-lg shadow-emerald-500/20 flex items-center justify-center space-x-2 transition font-mono text-sm">
                        <i class="fa-solid fa-user-plus"></i>
                        <span>REGISTER IDENTITY</span>
                    </button>
                </form>

                <div class="text-center pt-2 border-t border-secure-border text-xs text-slate-400">
                    Already enrolled? 
                    <button onclick="switchView('login')" class="text-emerald-400 font-bold hover:underline font-mono">Sign in</button>
                </div>
            </div>


            <!-- ==================== VIEW 4: SECURE DASHBOARD ==================== -->
            <div id="view-dashboard" class="glass-panel rounded-2xl p-8 auth-glow space-y-6 hidden w-full max-w-2xl">
                <div class="flex items-center justify-between border-b border-secure-border pb-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-12 h-12 rounded-xl bg-emerald-950 text-emerald-400 border border-emerald-800 flex items-center justify-center font-bold text-lg">
                            AM
                        </div>
                        <div>
                            <h3 class="font-bold text-base text-slate-100">Alex Mercer</h3>
                            <p class="text-xs text-slate-400 font-mono">Security Operations Lead • Level 4 Clearance</p>
                        </div>
                    </div>
                    <button onclick="handleLogout()" class="px-4 py-2 bg-red-950/40 hover:bg-red-900/50 border border-red-800/60 text-red-300 text-xs rounded-xl font-mono transition flex items-center space-x-2">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Sign Out</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-xs">
                    <div class="bg-secure-dark/80 p-4 rounded-xl border border-secure-border">
                        <span class="text-slate-500 block mb-1">Session Token</span>
                        <span class="text-emerald-400 font-bold truncate block">jwt_sec_99a8f...</span>
                    </div>
                    <div class="bg-secure-dark/80 p-4 rounded-xl border border-secure-border">
                        <span class="text-slate-500 block mb-1">IP Address</span>
                        <span class="text-slate-200 font-bold">192.168.4.102</span>
                    </div>
                    <div class="bg-secure-dark/80 p-4 rounded-xl border border-secure-border">
                        <span class="text-slate-500 block mb-1">MFA Status</span>
                        <span class="text-emerald-400 font-bold">Verified (TOTP)</span>
                    </div>
                </div>

                <div class="space-y-3">
                    <h4 class="font-bold text-sm uppercase tracking-wider font-mono text-emerald-400 flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left"></i> Recent Authentication & Session Log
                    </h4>
                    <div class="bg-secure-dark/90 rounded-xl p-4 border border-secure-border space-y-3 font-mono text-xs">
                        <div class="flex items-center justify-between text-slate-300 border-b border-secure-border/60 pb-2">
                            <span class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400"></i> Successful Login (MFA Passed)</span>
                            <span class="text-slate-500">Just now</span>
                        </div>
                        <div class="flex items-center justify-between text-slate-300 border-b border-secure-border/60 pb-2">
                            <span class="flex items-center gap-2"><i class="fa-solid fa-key text-indigo-400"></i> OAuth Token Refreshed</span>
                            <span class="text-slate-500">2 hours ago</span>
                        </div>
                        <div class="flex items-center justify-between text-slate-300">
                            <span class="flex items-center gap-2"><i class="fa-solid fa-shield text-cyan-400"></i> Trusted Device Registered</span>
                            <span class="text-slate-500">Yesterday</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-secure-border bg-secure-card/50 py-6 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 font-mono">
            <p>© 2026 SecureAuth Enterprise • Zero-Trust Access Protocol</p>
            <div class="flex space-x-4 mt-3 sm:mt-0">
                <span class="text-emerald-400/80"><i class="fa-solid fa-lock mr-1"></i> End-to-End Encrypted</span>
                <span>•</span>
                <span class="text-slate-400">SOC2 Type II Compliant</span>
            </div>
        </div>
    </footer>


    <!-- JavaScript Application Logic -->
    <script>
        function switchView(viewName) {
            const views = ['login', 'mfa', 'register', 'dashboard'];
            views.forEach(v => {
                document.getElementById(`view-${v}`).classList.add('hidden');
            });
            document.getElementById(`view-${viewName}`).classList.remove('hidden');

            const topBtn = document.getElementById('top-switch-btn');
            if (viewName === 'login') {
                topBtn.innerText = "Create Account";
                topBtn.setAttribute("onclick", "switchView('register')");
            } else if (viewName === 'register') {
                topBtn.innerText = "Sign In";
                topBtn.setAttribute("onclick", "switchView('login')");
            } else {
                topBtn.innerText = "SecOps Portal";
                topBtn.setAttribute("onclick", "switchView('login')");
            }
        }

        function togglePasswordVisibility(id) {
            const input = document.getElementById(id);
            const icon = document.getElementById(`${id}-icon`);
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = "fa-solid fa-eye-slash text-xs";
            } else {
                input.type = 'password';
                icon.className = "fa-solid fa-eye text-xs";
            }
        }

        function checkPasswordStrength(password) {
            let score = 0;
            if (password.length >= 8) score++;
            if (/[A-Z]/.test(password)) score++;
            if (/[0-9]/.test(password)) score++;
            if (/[^A-Za-z0-9]/.test(password)) score++;

            const bars = [
                document.getElementById('str-1'),
                document.getElementById('str-2'),
                document.getElementById('str-3'),
                document.getElementById('str-4')
            ];
            const text = document.getElementById('password-strength-text');

            const colors = ['bg-red-500', 'bg-amber-500', 'bg-yellow-500', 'bg-emerald-500'];
            const labels = ['Password strength: Weak', 'Password strength: Fair', 'Password strength: Good', 'Password strength: Strong'];

            bars.forEach((bar, index) => {
                bar.className = index < score ? `w-1/4 ${colors[score - 1]} transition-all` : 'w-1/4 bg-secure-border transition-all';
            });
            text.innerText = password.length > 0 ? labels[score - 1] || 'Password strength: Weak' : 'Password strength: Weak';
        }

        function handleLogin(event) {
            event.preventDefault();
            const btn = document.getElementById('login-btn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i><span>VERIFYING CREDENTIALS...</span>';

            setTimeout(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket"></i><span>AUTHENTICATE</span>';
                switchView('mfa');
            }, 800);
        }

        function handleMfaVerify(event) {
            event.preventDefault();
            const btn = document.getElementById('mfa-btn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i><span>VALIDATING TOTP...</span>';

            setTimeout(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-check"></i><span>VERIFY & PROCEED</span>';
                switchView('dashboard');
            }, 800);
        }

        function handleRegister(event) {
            event.preventDefault();
            alert('Identity enrolled successfully. A verification challenge has been sent to your device.');
            switchView('login');
        }

        function handleLogout() {
            switchView('login');
        }
    </script>
</body>
</html>
